    "eastAfrica": ["pp_mpesa", "pp_flutterwave", "pp_card_visa_master"],
    "northAfrica": ["pp_card_visa_master", "pp_flutterwave"],
    "global": ["pp_card_visa_master", "pp_flutterwave"]
  },
  "routing": {
    "fallback": ["regionPreferred", "globalGateway", "manualReview"],
    "priority": [
      {
        "when": {
          "currency": "ZAR",
          "amount": {"max": 50000}
        },
        "prefer": ["pp_snapscan", "pp_flutterwave"],
        "weight": 10
      },
      {
        "when": {
          "currency": "NGN",
          "userSegment": "retail"
        },
        "prefer": ["pp_paystack", "pp_flutterwave"],
        "weight": 9
      },
      {
        "when": {
          "currency": "KES",
          "deviceType": "mobile"
        },
        "prefer": ["pp_mpesa"],
        "weight": 10
      },
      {
        "when": {
          "userSegment": "lowData"
        },
        "prefer": ["pp_mpesa", "pp_snapscan"],
        "weight": 8
      },
      {
        "when": {
          "amount": {"min": 10000},
          "transactionType": "business"
        },
        "prefer": ["pp_flutterwave", "pp_card_visa_master"],
        "weight": 7
      },
      {
        "when": {
          "crossBorder": true
        },
        "prefer": ["pp_flutterwave", "pp_card_visa_master"],
        "weight": 6
      }
    ]
  },
  "settlementRules": {
    "instantSettlementMax": 5000,
    "batchProcessingInterval": "PT1H",
    "reconciliationWindow": "PT2H",
    "autoRetryAttempts": 3
